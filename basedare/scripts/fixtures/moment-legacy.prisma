// Exact pre-Moments submission fields; minimal read-only Venue relation.
generator client {
  provider = "prisma-client-js"
  output = env("LEGACY_MOMENT_CLIENT_DIR")
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
model Venue {
  id String @id
  slug String @unique
  name String
  latitude Float
  longitude Float
  submissions AdventureSubmission[]
}
model AdventureSubmission {
  id String @id @default(cuid())
  wallet String
  activityId String
  runId String
  venueSlug String
  venue Venue @relation(fields: [venueSlug], references: [slug], onDelete: Restrict, onUpdate: Cascade)
  caption String
  hashtag String
  mediaUrl String
  mediaType String
  status String @default("PENDING")
  publicConsentVersion String
  promotionContact Boolean @default(false)
  reviewReason String?
  reviewedBy String?
  reviewedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([wallet, runId])
  @@index([status, createdAt])
  @@index([venueSlug, status])
  @@index([hashtag, status])
}
